# Deliver finished transcripts via Webex; set false to keep them local only
WEBEX_DELIVERY_ENABLED=true

# Webex Bot Access Token (get from developer.webex.com)
WEBEX_ACCESS_TOKEN=your_webex_personal_access_token_here

# Personal Webex email that receives meeting transcripts in a direct 1:1 chat
WEBEX_RECIPIENT_EMAIL=your_webex_email@example.com

# Optional My Agent bot address shown in transcript forwarding instructions
MY_AGENT_EMAIL=your_agent@webex.bot

# OBS Studio WebSocket Server Settings (Tools -> WebSocket Server Settings in OBS)
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
OBS_WS_PASSWORD=your_obs_websocket_password_here
# Keep OBS ready between calls. Existing true/RELAUNCH_OBS_PER_CALL values still apply.
EXIT_OBS_ON_RECORDING_STOP=false
# 0 disables maintenance. Restarts require 2 quiet minutes and avoid :00/:30 +/- 5 min.
OBS_IDLE_RESTART_MINUTES=60

# Local Apple MLX Whisper model name
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
ENABLE_DIARIZATION=true
# Required for neural diarization. Create a Read token after accepting access:
# https://huggingface.co/settings/tokens
# https://huggingface.co/pyannote/speaker-diarization-community-1
# This agreement is separate from the older 3.1 model's access conditions.
HF_TOKEN=your_hugging_face_read_token_here

# Storage & Retention
RECORDINGS_DIR=~/Movies/WebexRecordings
TRANSCRIPTS_DIR=~/Documents/WebexTranscripts
# Durable private processing checkpoints live in LOG_DIR/jobs; keep this path stable.
LOG_DIR=~/Library/Logs/WebexOBS
# Only successfully processed application-owned media is pruned.
# 0 removes eligible media immediately after successful transcription/delivery.
# Active, queued, failed, recoverable, unrelated and legacy media is retained.
RETENTION_DAYS=14
POLL_INTERVAL=3.0
CALL_END_GRACE_SECONDS=15.0

# Global Keyboard Shortcuts (pynput syntax)
HOTKEY_AUDIO=<cmd>+<shift>+a
HOTKEY_VIDEO=<cmd>+<shift>+v
HOTKEY_VIDEO_SOURCE=<cmd>+<shift>+r
HOTKEY_STOP_TRANSCRIBE=<cmd>+<shift>+s

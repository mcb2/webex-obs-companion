# Setup and Settings preserve unedited keys and comments. Values are literal;
# ${...} is not interpolated. Folder paths support ~ expansion.
# Deliver finished transcripts via Webex; set false to keep them local only
WEBEX_DELIVERY_ENABLED=true

# Webex Bot Access Token (get from developer.webex.com; not a personal access token)
WEBEX_ACCESS_TOKEN=your_webex_bot_access_token_here

# Personal Webex email that receives meeting transcripts in a direct 1:1 chat
WEBEX_RECIPIENT_EMAIL=your_webex_email@example.com
# Optional space ID; takes precedence over recipient email. Bot must belong to it.
WEBEX_ROOM_ID=

# Optional My Agent bot address shown in transcript forwarding instructions
# Forwarding and summary requests are manual; the companion only delivers transcripts.
MY_AGENT_EMAIL=your_agent@webex.bot

# OBS Studio WebSocket Server Settings (Tools -> WebSocket Server Settings in OBS)
# Each recording start attempts Restart Capture on all macOS Audio Capture sources.
# OBS disables this for healthy capture; failures are logged and do not block start.
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
OBS_WS_PASSWORD=your_obs_websocket_password_here
# Keep OBS ready between calls. Existing true/RELAUNCH_OBS_PER_CALL values still apply.
EXIT_OBS_ON_RECORDING_STOP=false
# 0 disables maintenance. Restarts require 2 quiet minutes and avoid :00/:30 +/- 5 min.
OBS_IDLE_RESTART_MINUTES=60
# New persistent Webex video windows: prompt (default) or always_switch.
SHARED_WINDOW_BEHAVIOR=prompt

# Local Apple MLX Whisper model name
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
ENABLE_DIARIZATION=true
# Required for neural diarization. Create a Read token after accepting access:
# https://huggingface.co/settings/tokens
# https://huggingface.co/pyannote/speaker-diarization-community-1
# This agreement is separate from the older 3.1 model's access conditions.
HF_TOKEN=your_hugging_face_read_token_here

# Storage & Retention
# Applied and verified in OBS before each start (changes require WebSocket 5.3+).
# Created and checked for local write access; also used for retention cleanup.
# Live changes wait for the next session; existing media is not moved.
RECORDINGS_DIR=~/Movies/WebexRecordings
TRANSCRIPTS_DIR=~/Documents/WebexTranscripts
# Durable private processing checkpoints live in LOG_DIR/jobs; keep this path stable.
# Only finalized checkpointed jobs recover after restart, not active capture paths.
# Failed/blocked/uncertain deliveries require review; never automatically resend.
LOG_DIR=~/Library/Logs/WebexOBS
# Only successfully processed application-owned media is pruned.
# 0 deletes recordings immediately after complete successful transcription,
# before Webex delivery (even if delivery fails). Transcripts are kept.
# Failed/partial transcription, active, unrelated and legacy media is retained.
RETENTION_DAYS=14
# Opt-in diagnostic dialogs/logging use the CLI switch --detection-diagnostics
# (start/run/install-service); no environment setting is required.
POLL_INTERVAL=3.0
# Continuous confirmed inactivity on the originating platform; failed reads reset the timer.
CALL_END_GRACE_SECONDS=15.0

# Global Keyboard Shortcuts (pynput syntax)
HOTKEY_AUDIO=<cmd>+<shift>+a
HOTKEY_VIDEO=<cmd>+<shift>+v
HOTKEY_VIDEO_SOURCE=<cmd>+<shift>+r
HOTKEY_STOP_TRANSCRIBE=<cmd>+<shift>+s
